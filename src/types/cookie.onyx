package nimbus

use core.time
use core.io {Writer}

Cookie :: struct {
    name: str
    value: str
    expires: ? time.Timestamp 
    path: str
    domain: str
    max_age: i32
    secure: bool
    http_only: bool
    same_site: SameSite

    SameSite :: enum {
        Default
        None
        Lax
        Strict
    }
}

#package
cookie_write :: (c: &Cookie, w: &io.Writer) {
    Writer.write(w, c.name)
    Writer.write(w, "=")
    Writer.write(w, c.value)

    if c.path {
        Writer.write_format(w, "; Path={}", c.path)
    }

    if c.domain {
        // Robustness: check for invalid cookie domain.
        Writer.write_format(w, "; Domain={}", c.domain)
    }

    if c.expires as e {
        Writer.write_format(w, "; Expires={}", e->format("%a, %d %b %Y %H:%M:%S GMT"))
    }

    if c.max_age > 0 {
        Writer.write_format(w, "; Max-Age={}", c.max_age)
    } elseif c.max_age < 0 {
        Writer.write(w, "; Max-Age=0")
    }
    
    if c.http_only {
        Writer.write(w, "; HttpOnly")
    }

    if c.secure {
        Writer.write(w, "; Secure")
    }

    switch c.same_site {
        case .Default ---
        case _ do Writer.write_format(w, "; SameSite={}", c.same_site)
    }

    // Note: Not supporting partitioned cookies
}

