package nimbus

#package {
    use core

    core   :: core
    alloc  :: core.alloc
    io     :: core.io
    os     :: core.os
    arena  :: core.alloc.arena
    conv   :: core.conv
    time   :: core.time
    sync   :: core.sync
}

use runtime
#if (runtime.runtime == .Onyx) ||
    (runtime.runtime == .Wasi && #defined(runtime.vars.WASIX))
{
    #package net :: core.net
    #package thread :: core.thread
    #load "./src/hosting/tcp_server"
}


#load "./src"
#load "./src/types"
#load "./src/middleware"
#load "./src/internal"
#load "./src/utils"
#load "./src/hosting/cgi"
